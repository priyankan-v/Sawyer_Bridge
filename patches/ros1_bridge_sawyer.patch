+// ROS 2 bool sequences use vector<bool> proxies, not contiguous byte storage.
+// ROS 1 encodes each boolean as one uint8_t. Preserve that wire representation.
+template<typename ALLOC_T>
+static void streamPrimitiveVector(
+  ros::serialization::OStream & stream, const std::vector<bool, ALLOC_T> & vec)
+{
+  for (bool item : vec) {
+    const uint8_t value = item ? 1 : 0;
+    stream.next(value);
+  }
+}
+
+template<typename ALLOC_T>
+static void streamPrimitiveVector(
+  ros::serialization::IStream & stream, std::vector<bool, ALLOC_T> & vec)
+{
+  for (size_t i = 0; i < vec.size(); ++i) {
+    uint8_t value;
+    stream.next(value);
+    vec[i] = value != 0;
+  }
+}
+
+template<typename ALLOC_T>
+static void streamPrimitiveVector(
+  ros::serialization::LStream & stream, const std::vector<bool, ALLOC_T> & vec)
+{
+  stream.advance(vec.size());
+}
